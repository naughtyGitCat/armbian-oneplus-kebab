From: kebab bring-up notes <devnull@localhost>
Subject: [PATCH] arm64: dts: qcom: sm8250-oneplus-kebab: QCA6390 PMU / ath11k

Switch the OnePlus 8T kebab DTS from the obsolete qcom,qca6390 genpd
binding to qcom,qca6390-pmu so pwrseq-qcom-wcn can power the chip.
This phone's RPMH cmd-db has no smpf* resources, so PM8009 smps2
(vreg_s2f_0p95) must not be referenced.

---
--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-kebab.dts	2026-08-18 20:43:48
+++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-kebab.dts	2026-08-18 20:43:48
@@ -11,6 +11,18 @@
 #include "pm8009.dtsi"
 
 /*
+ * Local delta vs Armbian sm8250 0011 kebab DTS (d4n1 / Jiali Chen):
+ *   qcom,qca6390 genpd -> qcom,qca6390-pmu (pwrseq-qcom-wcn)
+ *   PMU supplies use vreg_s6a_0p95 (no smpf* / PM8009 on this phone)
+ *   PM8009 regulators-0 disabled
+ *   pcie0_phy no longer a consumer of qca639x genpd
+ *   wifi@0 (pci17cb,1101) under pcieport0
+ *   bluetooth takes PMU LDO supplies; enable GPIO owned by pwrseq
+ *
+ * See dts/patches/0001-sm8250-oneplus-kebab-qca6390-pmu-wifi.patch
+ */
+
+/*
  * Delete following upstream (sm8250.dtsi) reserved
  * memory mappings which are different in this device.
  */
@@ -189,24 +201,68 @@
 		regulator-always-on;
 	};
 
-	qca639x: qca639x {
-		compatible = "qcom,qca6390";
-		#power-domain-cells = <0>;
-        
+	/* QCA6390 PMU: pwrseq-qcom-wcn, not the old genpd compatible. */
+	qca639x: qca6390-pmu {
+		compatible = "qcom,qca6390-pmu";
+
 		vddaon-supply = <&vreg_s6a_0p95>;
-		vddpmu-supply = <&vreg_s2f_0p95>;
-		vddrfa1-supply = <&vreg_s2f_0p95>;
-		vddrfa2-supply = <&vreg_s8c_1p3>;
-		vddrfa3-supply = <&vreg_s5a_1p9>;
-		vddpcie1-supply = <&vreg_s8c_1p3>;
-		vddpcie2-supply = <&vreg_s5a_1p9>;
+		/* This 8T cmd-db has no smpf* — do not use vreg_s2f_0p95 / PM8009. */
+		vddpmu-supply = <&vreg_s6a_0p95>;
+		vddrfa0p95-supply = <&vreg_s6a_0p95>;
+		vddrfa1p3-supply = <&vreg_s8c_1p3>;
+		vddrfa1p9-supply = <&vreg_s5a_1p9>;
+		vddpcie1p3-supply = <&vreg_s8c_1p3>;
+		vddpcie1p9-supply = <&vreg_s5a_1p9>;
 		vddio-supply = <&vreg_s4a_1p8>;
 
 		pinctrl-names = "default", "sleep";
-		pinctrl-0 = <&wlan_en_active>;
-		pinctrl-1 = <&wlan_en_sleep>;
+		pinctrl-0 = <&wlan_en_active>, <&bt_en_active>;
+		pinctrl-1 = <&wlan_en_sleep>, <&bt_en_sleep>;
 
-		wlan-en-gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
+		wlan-enable-gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>;
+
+		regulators {
+			vreg_pmu_rfa_cmn: ldo0 {
+				regulator-name = "vreg_pmu_rfa_cmn";
+			};
+
+			vreg_pmu_aon_0p59: ldo1 {
+				regulator-name = "vreg_pmu_aon_0p59";
+			};
+
+			vreg_pmu_wlcx_0p8: ldo2 {
+				regulator-name = "vreg_pmu_wlcx_0p8";
+			};
+
+			vreg_pmu_wlmx_0p85: ldo3 {
+				regulator-name = "vreg_pmu_wlmx_0p85";
+			};
+
+			vreg_pmu_btcmx_0p85: ldo4 {
+				regulator-name = "vreg_pmu_btcmx_0p85";
+			};
+
+			vreg_pmu_rfa_0p8: ldo5 {
+				regulator-name = "vreg_pmu_rfa_0p8";
+			};
+
+			vreg_pmu_rfa_1p2: ldo6 {
+				regulator-name = "vreg_pmu_rfa_1p2";
+			};
+
+			vreg_pmu_rfa_1p7: ldo7 {
+				regulator-name = "vreg_pmu_rfa_1p7";
+			};
+
+			vreg_pmu_pcie_0p9: ldo8 {
+				regulator-name = "vreg_pmu_pcie_0p9";
+			};
+
+			vreg_pmu_pcie_1p8: ldo9 {
+				regulator-name = "vreg_pmu_pcie_1p8";
+			};
+		};
 	};
 
 	battery: battery {
@@ -222,6 +278,8 @@
 	regulators-0 {
 		compatible = "qcom,pm8009-1-rpmh-regulators";
 		qcom,pmic-id = "f";
+		/* cmd-db on tested 8T units has no smpf* resources */
+		status = "disabled";
 
 		vdd-s1-supply = <&vph_pwr>;
 		vdd-s2-supply = <&vph_pwr>;
@@ -616,13 +674,29 @@
 
 &pcie0 {
 	status = "okay";
+};
+
+&pcieport0 {
+	wifi@0 {
+		compatible = "pci17cb,1101";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p7-supply = <&vreg_pmu_rfa_1p7>;
+		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
+		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
+	};
 };
 
 &pcie0_phy {
 	vdda-phy-supply = <&vreg_l5a_0p88>;
 	vdda-pll-supply = <&vreg_l9a_1p2>;
 	status = "okay";
-	power-domains = <&qca639x>;
 };
 
 &pcie1 {
@@ -761,8 +835,12 @@
 		pinctrl-0 = <&bt_en_active>;
 		pinctrl-1 = <&bt_en_sleep>;
 
-		power-domains = <&qca639x>;
-		enable-gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>;
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddbtcmx-supply = <&vreg_pmu_btcmx_0p85>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p7-supply = <&vreg_pmu_rfa_1p7>;
 	};
 };
 
